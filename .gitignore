# видео, кадры, озвучка, образцы голоса — папки сборки, не коммитим (собираются из кода)
videos/
media/

# окружение и кэши
.venv/
__pycache__/
*.pyc
.DS_Store

# секреты: ключ OpenAI и прочее локальное
.env
.env.*
*.local

# окружения сторонних инструментов (STORM и др.)
.venvs/

# модели и текстуры для Blender — только список с лицензиями (assets/MANIFEST.md)
assets/*/

# arxiv/: тексты статей и отчёты сохраняем, сами статьи (страницы, pdf) и журналы сессий — нет
arxiv/**/*.html
arxiv/**/*.pdf
arxiv/**/conversation/
